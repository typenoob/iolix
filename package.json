{
  "name": "iolix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "worker:build": "wrangler pages functions build --outdir=./dist-worker",
    "dev": "npm run build && npm run worker:build && wrangler dev",
    "deploy": "npm run build && npm run worker:build && wrangler deploy",
    "lint": "vue-cli-service lint",
    "kv:create": "wrangler kv namespace create iolix-db",
    "kv:import": "wrangler kv key put db --path=db.json --namespace-id=d85295d9f56c40c5af00c426d7aad334",
    "crawler:dev": "cd crawler && wrangler dev --test-scheduled",
    "crawler:deploy": "cd crawler && wrangler deploy",
    "crawler:tail": "cd crawler && wrangler tail"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^6.0.1",
    "ant-design-vue": "^2.2.8",
    "axios": "^0.26.0",
    "core-js": "^3.8.3",
    "vant": "^3.4.5",
    "vue": "^3.2.13",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "wrangler": "^4.145.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
